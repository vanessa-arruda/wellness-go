#!/usr/bin/env bash
# Enforces this repo's commit message convention: type(wellness-go): description
set -euo pipefail

commit_msg_file="$1"
first_line="$(head -n 1 "$commit_msg_file")"

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)\(wellness-go\): .+'

if [[ ! "$first_line" =~ $pattern ]]; then
  echo "Commit message rejected: doesn't match the required format." >&2
  echo "" >&2
  echo "  type(wellness-go): description" >&2
  echo "" >&2
  echo "where type is one of: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert" >&2
  echo "" >&2
  echo "Got:" >&2
  echo "  $first_line" >&2
  exit 1
fi
